# Enforce LF line endings for all text files
* text=auto eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.zip binary

# Flutter/Dart
*.dart text eol=lf
*.yaml text eol=lf

# TypeScript/JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# Config
*.md text eol=lf
*.yml text eol=lf
*.toml text eol=lf
