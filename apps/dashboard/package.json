{
  "name": "@wapcentral/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "WAPCentral Admin Dashboard — Phase 2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wapcentral/config": "workspace:*",
    "@wapcentral/types": "workspace:*",
    "@wapcentral/ui": "workspace:*",
    "@wapcentral/validation": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
