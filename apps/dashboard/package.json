{
  "name": "@wapcentral/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "WAPCentral Admin Dashboard — Phase 2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wapcentral/config": "workspace:*",
    "@wapcentral/types": "workspace:*",
    "@wapcentral/ui": "workspace:*",
    "@wapcentral/validation": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "rimraf": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
