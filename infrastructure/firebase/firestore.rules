rules_version = '2';

/**
 * Production Firestore Security Rules — WebAppyPie Central (WAPCentral)
 *
 * Implements strict Role-Based Access Control (RBAC):
 * - viewer: Read-only access to dashboard data (apps, metrics, campaigns, flags)
 * - editor: Can manage apps, campaigns, assets, and feature flags
 * - admin: Can manage providers, models, policies, delete resources, read logs
 * - super_admin: Full system control including role assignments
 *
 * Golden Rules:
 * 1. Zero unauthenticated access to any collection.
 * 2. Sensitive backend collections (usageDaily, usageEvents, healthChecks, auditLogs)
 *    are append-only / write-protected for clients. Only backend services using
 *    Firebase Admin SDK can write to them.
 * 3. Client writes are forbidden from storing private credentials or API keys.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper Functions
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Role resolution: checks custom claims first, falls back to roles/{uid} document
    function getUserRole() {
      return ('role' in request.auth.token && request.auth.token.role != null)
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/roles/$(request.auth.uid))
            ? get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role
            : 'unassigned');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getUserRole() == 'super_admin' ||
        ('admin' in request.auth.token && request.auth.token.admin == true)
      );
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() in ['admin', 'super_admin'] || isSuperAdmin());
    }

    function isEditor() {
      return isSignedIn() && (getUserRole() in ['editor', 'admin', 'super_admin'] || isAdmin());
    }

    function isViewer() {
      return isSignedIn() && (getUserRole() in ['viewer', 'editor', 'admin', 'super_admin'] || isEditor());
    }

    // Verify document contains no private credentials or raw secret keys
    function hasNoPrivateSecrets(data) {
      return !('apiKey' in data.keys())
          && !('secret' in data.keys())
          && !('privateKey' in data.keys())
          && !('serviceAccount' in data.keys())
          && !('apiSecret' in data.keys())
          && !('signingSecret' in data.keys())
          && !('privateCredentials' in data.keys());
    }

    // Common immutability check on update
    function isNotMutatingIdAndCreation(data, resourceData) {
      return (!('id' in data.keys()) || data.id == resourceData.id)
          && (!('createdAt' in data.keys()) || data.createdAt == resourceData.createdAt);
    }

    // ============================================================
    // 1. Roles & RBAC (/roles/{userId})
    // ============================================================
    match /roles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // ============================================================
    // 2. Apps Registry (/apps/{appId})
    // ============================================================
    match /apps/{appId} {
      allow read: if isViewer();
      allow create: if isEditor()
                    && hasNoPrivateSecrets(request.resource.data);
      allow update: if isEditor()
                    && isNotMutatingIdAndCreation(request.resource.data, resource.data)
                    && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 3. Environments Registry (/environments/{envId})
    // ============================================================
    match /environments/{envId} {
      allow read: if isViewer();
      allow write: if isAdmin();
    }

    // ============================================================
    // 4. AI Providers Registry (/providers/{providerId})
    // Stored metadata ONLY. Raw secrets reside in Secret Manager.
    // ============================================================
    match /providers/{providerId} {
      allow read: if isViewer();
      allow create, update: if isAdmin()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // 5. AI Models Allowlist (/models/{modelId})
    // ============================================================
    match /models/{modelId} {
      allow read: if isViewer();
      allow write: if isAdmin();
    }

    // ============================================================
    // 6. AI Gateway Policies (/aiPolicies/{policyId})
    // ============================================================
    match /aiPolicies/{policyId} {
      allow read: if isViewer();
      allow write: if isAdmin();
    }

    // ============================================================
    // 7. Self-Promotion Campaigns (/campaigns/{campaignId})
    // ============================================================
    match /campaigns/{campaignId} {
      allow read: if isViewer();
      allow create: if isEditor()
                    && hasNoPrivateSecrets(request.resource.data);
      allow update: if isEditor()
                    && isNotMutatingIdAndCreation(request.resource.data, resource.data)
                    && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 8. Campaign Creative Assets Metadata (/campaignAssets/{assetId})
    // ============================================================
    match /campaignAssets/{assetId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 9. Feature Flags (/featureFlags/{flagId})
    // Primary source of truth for dashboard-managed configuration
    // ============================================================
    match /featureFlags/{flagId} {
      allow read: if isViewer();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    // ============================================================
    // 10. Usage Daily Aggregation (/usageDaily/{dailyId})
    // Client write is FORBIDDEN. Only backend usage-worker writes.
    // ============================================================
    match /usageDaily/{dailyId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ============================================================
    // 11. Raw Usage Events (/usageEvents/{eventId})
    // Client write is FORBIDDEN. Only ai-gateway writes.
    // ============================================================
    match /usageEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // 12. Health Checks (/healthChecks/{checkId})
    // Client write is FORBIDDEN. Only health-worker writes.
    // ============================================================
    match /healthChecks/{checkId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ============================================================
    // 13. Audit Logs (/auditLogs/{logId})
    // Immutable audit trail. Direct client write is completely blocked.
    // ============================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // 14. Promotion Events (/promotionEvents/{eventId})
    // Client write is FORBIDDEN. Only promotion-api writes.
    // ============================================================
    match /promotionEvents/{eventId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ============================================================
    // 15. Cost Alert Rules (/costAlerts/{alertId})
    // ============================================================
    match /costAlerts/{alertId} {
      allow read: if isViewer();
      allow create, update, delete: if isAdmin()
                                    && hasNoPrivateSecrets(request.resource.data);
    }

    // ============================================================
    // 16. Data Retention Policy (/dataRetention/{policyId})
    // ============================================================
    match /dataRetention/{policyId} {
      allow read: if isViewer();
      allow write: if isAdmin()
                    && hasNoPrivateSecrets(request.resource.data);
    }

    // ============================================================
    // 17. Infrastructure Alerts (/infrastructureAlerts/{alertId})
    // ============================================================
    match /infrastructureAlerts/{alertId} {
      allow read: if isViewer();
      allow create, update, delete: if isAdmin()
                                    && hasNoPrivateSecrets(request.resource.data);
    }

    // ============================================================
    // 18. AI Server Metrics (/aiServerMetrics/{serverId})
    // Client write is FORBIDDEN. Only health-worker/node agent writes.
    // ============================================================
    match /aiServerMetrics/{serverId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ============================================================
    // 19. Ad Networks Registry (/adNetworks/{networkId})
    // ============================================================
    match /adNetworks/{networkId} {
      allow read: if isViewer();
      allow create, update: if isAdmin()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // 20. App-wise Ad Configuration (/adApps/{appId})
    // ============================================================
    match /adApps/{appId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 21. Ad Units Registry (/adUnits/{unitId})
    // ============================================================
    match /adUnits/{unitId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 22. Ad Placements Registry (/adPlacements/{placementId})
    // ============================================================
    match /adPlacements/{placementId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 23. Ad Rotation & Mediation Policies (/adRotationPolicies/{policyId})
    // ============================================================
    match /adRotationPolicies/{policyId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 24. Ad Frequency Policies (/adFrequencyPolicies/{policyId})
    // ============================================================
    match /adFrequencyPolicies/{policyId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 25. Ad Safety Policies (/adSafetyPolicies/{policyId})
    // ============================================================
    match /adSafetyPolicies/{policyId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 26. Custom Ad Campaigns (/customAdCampaigns/{campaignId})
    // ============================================================
    match /customAdCampaigns/{campaignId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 27. Custom Ad Creatives (/customAdCreatives/{creativeId})
    // ============================================================
    match /customAdCreatives/{creativeId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 28. Ad Kill Switches (/adKillSwitches/{switchId})
    // ============================================================
    match /adKillSwitches/{switchId} {
      allow read: if isViewer();
      allow create, update: if isAdmin()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // 29. Ad Audit Logs (/adAuditLogs/{logId})
    // Client write is FORBIDDEN. Only backend admin-api writes.
    // ============================================================
    match /adAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // 30. Notification Templates (/notificationTemplates/{templateId})
    // ============================================================
    match /notificationTemplates/{templateId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 31. Notifications (/notifications/{notificationId})
    // ============================================================
    match /notifications/{notificationId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 32. Notification Recipients (/notificationRecipients/{recipientId})
    // Write-protected: Written exclusively by backend / Admin SDK.
    // ============================================================
    match /notificationRecipients/{recipientId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ============================================================
    // 33. Notification Devices (/notificationDevices/{deviceId})
    // Write-protected: Managed exclusively via platform API.
    // ============================================================
    match /notificationDevices/{deviceId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ============================================================
    // 34. Notification Preferences (/notificationPreferences/{prefId})
    // Write-protected: Managed exclusively via platform API.
    // ============================================================
    match /notificationPreferences/{prefId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ============================================================
    // 35. Notification Categories (/notificationCategories/{categoryId})
    // ============================================================
    match /notificationCategories/{categoryId} {
      allow read: if isViewer();
      allow create, update: if isEditor()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 36. Notification Delivery Logs (/notificationDeliveryLogs/{logId})
    // Append-only for backend; read-only for admins.
    // ============================================================
    match /notificationDeliveryLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // 37. Notification Audit Logs (/notificationAuditLogs/{logId})
    // Append-only for backend; read-only for admins.
    // ============================================================
    match /notificationAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================================
    // 38. Notification Settings (/notificationSettings/{settingId})
    // ============================================================
    match /notificationSettings/{settingId} {
      allow read: if isViewer();
      allow create, update: if isAdmin()
                            && hasNoPrivateSecrets(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // 39. Ad Telemetry Raw Events
    // Client direct write is FORBIDDEN. Only backend platform/admin API writes.
    // ============================================================
    match /adImpressionEvents/{eventId} {
      allow read: if isViewer();
      allow write: if false;
    }

    match /adClickEvents/{eventId} {
      allow read: if isViewer();
      allow write: if false;
    }

    match /adRequestEvents/{eventId} {
      allow read: if isViewer();
      allow write: if false;
    }

    match /adFillEvents/{eventId} {
      allow read: if isViewer();
      allow write: if false;
    }

    match /adFailureEvents/{eventId} {
      allow read: if isViewer();
      allow write: if false;
    }

    match /adRewardEvents/{eventId} {
      allow read: if isViewer();
      allow write: if false;
    }

    match /adProviderEvents/{eventId} {
      allow read: if isViewer();
      allow write: if false;
    }

    match /customAdAnalytics/{eventId} {
      allow read: if isViewer();
      allow write: if false;
    }

    match /notificationAnalytics/{eventId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // ============================================================
    // 40. Analytics Daily Aggregates (/analyticsDailyAggregates/{docId})
    // Client write is FORBIDDEN. Only backend aggregation worker writes.
    // ============================================================
    match /analyticsDailyAggregates/{docId} {
      allow read: if isViewer();
      allow write: if false;
    }

    // Default deny catch-all for any undefined paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
