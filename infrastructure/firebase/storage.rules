rules_version = '2';

/**
 * Production Firebase Storage Security Rules — WebAppyPie Central (WAPCentral)
 *
 * Rules governing campaign creative assets:
 * - Public read for campaign creatives so mobile apps (via wap_promo_sdk) can
 *   fetch images and animations directly without authentication bottlenecks.
 * - Writes restricted to authenticated staff with editor, admin, or super_admin roles.
 * - Enforces content-type limits (PNG, JPEG, WebP, GIF, Lottie JSON) and size constraints (max 5MB).
 * - All other paths default to DENY.
 */
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEditorOrAbove() {
      return isSignedIn()
          && request.auth.token.role != null
          && (request.auth.token.role in ['editor', 'admin', 'super_admin']);
    }

    function isValidCreativeContentType() {
      return request.resource.contentType.matches('image/(png|jpeg|webp|gif)')
          || request.resource.contentType.matches('video/(mp4|webm)')
          || request.resource.contentType == 'application/json';
    }

    function isValidFileSize() {
      // 50 MB limit for video creatives; 10 MB limit for image and Lottie animations
      return (request.resource.contentType.matches('video/(mp4|webm)') && request.resource.size <= 50 * 1024 * 1024)
          || (!request.resource.contentType.matches('video/(mp4|webm)') && request.resource.size <= 10 * 1024 * 1024);
    }

    // ============================================================
    // Campaign Creative Assets (/campaign-assets/{campaignId}/{allPaths=**})
    // ============================================================
    match /campaign-assets/{campaignId}/{allPaths=**} {
      // Public read allows client apps and CDN to fetch creatives
      allow read: if true;

      // Writes restricted to editors/admins with content validation
      allow write: if isEditorOrAbove()
                   && isValidCreativeContentType()
                   && isValidFileSize();
    }

    // Default deny catch-all
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
