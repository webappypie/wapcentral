{
  "name": "@wapcentral/admin-api",
  "version": "0.1.0",
  "private": true,
  "description": "WAPCentral Admin API Service — Phase 4",
  "type": "module",
  "scripts": {
    "dev": "node --watch dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wapcentral/config": "workspace:*",
    "@wapcentral/types": "workspace:*",
    "@wapcentral/validation": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
