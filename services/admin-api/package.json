{
  "name": "@wapcentral/admin-api",
  "version": "0.2.1",
  "private": true,
  "description": "WAPCentral Admin API Service — Phase 4",
  "type": "module",
  "scripts": {
    "dev": "node --watch dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.1.0",
    "@google-cloud/secret-manager": "^7.1.1",
    "@wapcentral/config": "workspace:*",
    "@wapcentral/provider-sdk": "workspace:*",
    "@wapcentral/types": "workspace:*",
    "@wapcentral/validation": "workspace:*",
    "@wapcentral/workers": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "pizzip": "^3.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pizzip": "^3.1.2",
    "@types/supertest": "^7.2.1",
    "rimraf": "^6.0.0",
    "supertest": "^7.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
