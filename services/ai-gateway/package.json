{
  "name": "@wapcentral/ai-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "WAPCentral AI Gateway Service — Phase 6",
  "type": "module",
  "scripts": {
    "dev": "node --watch dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@wapcentral/config": "workspace:*",
    "@wapcentral/provider-sdk": "workspace:*",
    "@wapcentral/types": "workspace:*",
    "@wapcentral/validation": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "rimraf": "^6.0.0",
    "supertest": "^7.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
